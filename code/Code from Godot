
extends Node2D

# =========================
# MOVEMENT SETTINGS
# =========================

var speed = 100.0
var direction = 1
var edge = "bottom"
var corner_cooldown = 0.0
var screen_size = Vector2()
var window_size = Vector2(200, 200)

# =========================
# DRAGGING
# =========================

var is_dragging = false
var drag_offset = Vector2()

# =========================
# IDLE SETTINGS
# =========================

var is_idling = false
var idle_timer = 0.0

# Track missing animations
var warned_missing = {}

@onready var sprite = $AnimatedSprite2D
@onready var area = $Area2D


func _ready():
	randomize()

	# Transparent window
	get_viewport().transparent_bg = true

	DisplayServer.window_set_flag(
		DisplayServer.WINDOW_FLAG_TRANSPARENT, true
	)

	DisplayServer.window_set_flag(
		DisplayServer.WINDOW_FLAG_BORDERLESS, true
	)

	DisplayServer.window_set_flag(
		DisplayServer.WINDOW_FLAG_ALWAYS_ON_TOP, true
	)

	# Screen dimensions
	screen_size = Vector2(DisplayServer.screen_get_size())
	window_size = Vector2(DisplayServer.window_get_size())

	# Mouse detection
	area.input_pickable = true
	area.input_event.connect(_on_area_input)

	# Start on nearest edge
	_snap_to_nearest_edge()
	_update_animation()


# =========================
# MAIN MOVEMENT
# =========================

func _process(delta):

	if direction == 0:
		direction = 1
	corner_cooldown = maxf(0.0, corner_cooldown - delta)
	# DRAGGING
	if is_dragging:
		if Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT):
			var mouse_pos = Vector2(DisplayServer.mouse_get_position())
			var new_pos = mouse_pos - drag_offset

			DisplayServer.window_set_position(Vector2i(new_pos))
			_play_animation("pick_up")
		else:
			_release_pet()

		return

	# IDLE
	if is_idling:
		idle_timer -= delta

		if idle_timer <= 0:
			is_idling = false
			_update_animation()
		else:
			return

	# Get current window position
	var pos = Vector2(DisplayServer.window_get_position())

	var max_x = maxf(0.0, screen_size.x - window_size.x)
	var max_y = maxf(0.0, screen_size.y - window_size.y)

	# Move along current edge
	match edge:

		"bottom":
			pos.y = max_y
			pos.x += direction * speed * delta

			if pos.x >= max_x:
				pos.x = max_x
				_handle_corner()

			elif pos.x <= 0:
				pos.x = 0
				_handle_corner()

		"right":
			pos.x = max_x
			pos.y += direction * speed * delta

			if pos.y >= max_y:
				pos.y = max_y
				_handle_corner()

			elif pos.y <= 0:
				pos.y = 0
				_handle_corner()

		"top":
			pos.y = 0
			pos.x += direction * speed * delta

			if pos.x >= max_x:
				pos.x = max_x
				_handle_corner()

			elif pos.x <= 0:
				pos.x = 0
				_handle_corner()

		"left":
			pos.x = 0
			pos.y += direction * speed * delta

			if pos.y >= max_y:
				pos.y = max_y
				_handle_corner()

			elif pos.y <= 0:
				pos.y = 0
				_handle_corner()

	# Apply movement
	DisplayServer.window_set_position(Vector2i(pos))

	# Update animation
	if not is_idling:
		_update_animation()


# =========================
# CORNER BEHAVIOR
# =========================

func _handle_corner():

	# Prevent the same corner from triggering repeatedly
	if corner_cooldown > 0.0:
		return

	corner_cooldown = 0.25

	var turn = randf() < 0.5

	match edge:

		"bottom":
			if direction > 0:
				if turn:
					edge = "right"
					direction = -1
				else:
					direction = -1
			else:
				if turn:
					edge = "left"
					direction = -1
				else:
					direction = 1

		"right":
			if direction > 0:
				if turn:
					edge = "bottom"
					direction = -1
				else:
					direction = -1
			else:
				if turn:
					edge = "top"
					direction = -1
				else:
					direction = 1

		"top":
			if direction > 0:
				if turn:
					edge = "right"
					direction = 1
				else:
					direction = -1
			else:
				if turn:
					edge = "left"
					direction = 1
				else:
					direction = 1

		"left":
			if direction > 0:
				if turn:
					edge = "bottom"
					direction = 1
				else:
					direction = -1
			else:
				if turn:
					edge = "top"
					direction = 1
				else:
					direction = 1

	print("New edge: ", edge, " | Direction: ", direction)

	_maybe_idle()


# =========================
# ANIMATION SYSTEM
# =========================

func _update_animation():

	match edge:

		"bottom":
			_play_animation(
				"walk_right" if direction > 0 else "walk_left"
			)

		"right":
			_play_animation(
				"crawl_right_down" if direction > 0 else "crawl_right_up"
			)

		"left":
			_play_animation(
				"crawl_left_down" if direction > 0 else "crawl_left_up"
			)

		"top":
			_play_animation(
				"walk_right_ceiling" if direction > 0 else "walk_left_ceiling"
			)


func _play_animation(animation_name):

	if sprite.sprite_frames.has_animation(animation_name):

		if sprite.animation != animation_name or not sprite.is_playing():
			sprite.play(animation_name)

	elif not warned_missing.has(animation_name):

		warned_missing[animation_name] = true
		push_warning("Missing animation: " + animation_name)


# =========================
# IDLE BEHAVIOR
# =========================

func _maybe_idle():

	if randf() < 0.3:

		is_idling = true
		idle_timer = randf_range(1.0, 3.0)

		var choice = randi_range(0, 2)

		match choice:

			0:
				_play_animation("idle")

			1:
				_play_animation("crouch")

			2:
				_play_animation("splat")


# =========================
# MOUSE INPUT
# =========================

func _on_area_input(_viewport, event, _shape_idx):

	if event is InputEventMouseButton:

		if event.button_index == MOUSE_BUTTON_LEFT and event.pressed:

			is_dragging = true
			is_idling = false

			var mouse_pos = Vector2(DisplayServer.mouse_get_position())
			var win_pos = Vector2(DisplayServer.window_get_position())

			drag_offset = mouse_pos - win_pos

			_play_animation("pick_up")
func _input(event):

	if event is InputEventMouseButton:
		if event.button_index == MOUSE_BUTTON_LEFT and not event.pressed:
			if is_dragging:
				_release_pet()

# =========================
# RELEASE PET
# =========================

func _release_pet():
	corner_cooldown = 0.0
	if not is_dragging:
		return

	is_dragging = false
	is_idling = false
	idle_timer = 0.0

	# Refresh screen dimensions
	screen_size = Vector2(DisplayServer.screen_get_size())
	window_size = Vector2(DisplayServer.window_get_size())

	# Snap to the nearest screen edge
	_snap_to_nearest_edge()

	# Ensure valid movement direction
	if direction == 0:
		direction = 1

	# Resume walking animation
	_update_animation()

	print("PET RELEASED")
	print("Current edge: ", edge)
	print("Current direction: ", direction)
	print("Current position: ", DisplayServer.window_get_position())
# =========================
# SNAP TO NEAREST EDGE
# =========================

func _snap_to_nearest_edge():

	var pos = Vector2(DisplayServer.window_get_position())

	var max_x = maxf(0.0, screen_size.x - window_size.x)
	var max_y = maxf(0.0, screen_size.y - window_size.y)

	# Keep window within screen
	pos.x = clampf(pos.x, 0.0, max_x)
	pos.y = clampf(pos.y, 0.0, max_y)

	# Calculate distances
	var distances = {
		"left": pos.x,
		"right": max_x - pos.x,
		"top": pos.y,
		"bottom": max_y - pos.y
	}

	var closest_edge = "bottom"
	var smallest_distance = INF

	for key in distances:
		if distances[key] < smallest_distance:
			smallest_distance = distances[key]
			closest_edge = key

	edge = closest_edge

	# Align window to selected edge
	match edge:

		"bottom":
			pos.y = max_y

		"top":
			pos.y = 0

		"left":
			pos.x = 0

		"right":
			pos.x = max_x

	# Random direction
	direction = 1 if randf() < 0.5 else -1

	DisplayServer.window_set_position(Vector2i(pos))
